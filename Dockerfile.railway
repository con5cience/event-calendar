# Self-contained app and validated data snapshot. No runtime volume required.
FROM node:24-bookworm-slim AS frontend
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json vite.config.ts ./
COPY web ./web
COPY internal/artifact/schema ./internal/artifact/schema
COPY tests/contracts ./tests/contracts
RUN npm run build

FROM golang:1.26-bookworm AS backend
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /calendar ./cmd/calendar
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /package-snapshot ./cmd/package-snapshot

FROM backend AS snapshot
ARG LOCALE
COPY locales/${LOCALE}/ /site/
COPY .artifacts/${LOCALE}/ /input/
RUN test -n "$LOCALE" && /package-snapshot --site /site /input /snapshot

# Optional local export for railway up: only build inputs and the active snapshot.
# No Git metadata, node_modules, raw captures, or obsolete artifact generations.
FROM scratch AS upload-context
ARG LOCALE
COPY Dockerfile.railway Dockerfile.railway.dockerignore /
COPY package.json package-lock.json tsconfig.json vite.config.ts go.mod go.sum /
COPY web /web
COPY cmd /cmd
COPY internal /internal
COPY tests/contracts /tests/contracts
COPY --from=snapshot /site/ /locales/${LOCALE}/
COPY --from=snapshot /snapshot/ /.artifacts/${LOCALE}/

FROM scratch AS runtime
COPY --from=backend /calendar /calendar
COPY --from=frontend /build/dist /app/dist
COPY --from=snapshot /snapshot /data
COPY --from=snapshot /site/site.json /app/site/site.json
COPY --from=snapshot /site/assets /app/site/assets
USER 65532:65532
ENV PORT=8080 ASSETS_DIR=/app/dist DATA_DIR=/data SITE_DIR=/app/site
EXPOSE 8080
ENTRYPOINT ["/calendar"]
