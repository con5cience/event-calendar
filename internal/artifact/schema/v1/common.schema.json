{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://event-calendar.invalid/schema/v1/common.schema.json",
  "$defs": {
    "key": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "policy": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "format": "safe-http-url",
          "maxLength": 4096
        },
        "category": {
          "enum": ["All ages", "13+", "16+", "18+", "21+"]
        },
        "with_adult": {
          "$ref": "#/$defs/adultAdmission"
        }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "venue": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "timezone": {
          "type": "string",
          "format": "iana-time-zone",
          "pattern": "^(?:UTC|[A-Za-z_]+(?:/[A-Za-z0-9_+.-]+)+)$"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "website": {
          "type": "string",
          "format": "safe-http-url",
          "maxLength": 4096
        },
        "admission_policy": {
          "$ref": "https://event-calendar.invalid/schema/v1/common.schema.json#/$defs/policy"
        }
      },
      "required": ["key", "name"],
      "additionalProperties": false
    },
    "price": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "amount_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "min_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": ["text"],
      "additionalProperties": false,
      "dependentRequired": {
        "amount_minor": ["currency"],
        "min_minor": ["max_minor", "currency"],
        "max_minor": ["min_minor", "currency"]
      },
      "not": {
        "required": ["amount_minor", "min_minor"]
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "adapter": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": ["id", "adapter"],
      "additionalProperties": false
    },
    "match": {
      "type": "object",
      "properties": {
        "upstream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "venue_key": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": ["upstream_id", "date", "venue_key"],
      "additionalProperties": false
    },
    "override": {
      "type": "object",
      "properties": {
        "match": {
          "$ref": "https://event-calendar.invalid/schema/v1/common.schema.json#/$defs/match"
        },
        "set": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "\\S"
            },
            "performers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              },
              "maxItems": 100
            },
            "doors_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "show_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "price": {
              "$ref": "https://event-calendar.invalid/schema/v1/common.schema.json#/$defs/price"
            },
            "admission_policy": {
              "$ref": "https://event-calendar.invalid/schema/v1/common.schema.json#/$defs/policy"
            },
            "event_url": {
              "type": "string",
              "format": "safe-http-url",
              "maxLength": 4096
            },
            "ticket_url": {
              "type": "string",
              "format": "safe-http-url",
              "maxLength": 4096
            }
          },
          "required": [],
          "additionalProperties": false,
          "minProperties": 1
        },
        "remove": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "status",
              "performers",
              "doors_at",
              "show_at",
              "price",
              "admission_policy",
              "event_url",
              "ticket_url"
            ]
          }
        }
      },
      "required": ["match"],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["set"]
        },
        {
          "required": ["remove"]
        }
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "venue": {
          "$ref": "https://event-calendar.invalid/schema/v1/common.schema.json#/$defs/venue"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "performers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "maxItems": 100
        },
        "doors_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "show_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "price": {
          "$ref": "https://event-calendar.invalid/schema/v1/common.schema.json#/$defs/price"
        },
        "admission_policy": {
          "$ref": "https://event-calendar.invalid/schema/v1/common.schema.json#/$defs/policy"
        },
        "event_url": {
          "type": "string",
          "format": "safe-http-url",
          "maxLength": 4096
        },
        "ticket_url": {
          "type": "string",
          "format": "safe-http-url",
          "maxLength": 4096
        }
      },
      "required": ["date", "title"],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "venue": {
          "$ref": "https://event-calendar.invalid/schema/v1/common.schema.json#/$defs/venue"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "performers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "\\S"
          },
          "maxItems": 100
        },
        "doors_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "show_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "price": {
          "$ref": "https://event-calendar.invalid/schema/v1/common.schema.json#/$defs/price"
        },
        "admission_policy": {
          "$ref": "https://event-calendar.invalid/schema/v1/common.schema.json#/$defs/policy"
        },
        "event_url": {
          "type": "string",
          "format": "safe-http-url",
          "maxLength": 4096
        },
        "ticket_url": {
          "type": "string",
          "format": "safe-http-url",
          "maxLength": 4096
        },
        "id": {
          "type": "string",
          "maxLength": 113,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "upstream_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "\\S"
        },
        "public_path": {
          "type": "string",
          "maxLength": 400,
          "pattern": "^/events/[a-z0-9]+(?:-[a-z0-9]+)*/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*-[a-f0-9]{12}$"
        },
        "off_site": {
          "type": "boolean"
        },
        "listed": {
          "type": "boolean"
        },
        "expires_on": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "required": [
        "id",
        "upstream_id",
        "public_path",
        "date",
        "title",
        "off_site",
        "listed",
        "expires_on"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "through": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "complete": {
          "const": true
        }
      },
      "required": ["from", "through", "complete"],
      "additionalProperties": false
    },
    "adultAdmission": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/$defs/policy/properties/url"
        },
        "reviewed_on": {
          "$ref": "#/$defs/date"
        },
        "ranges": {
          "type": "array",
          "maxItems": 18,
          "items": {
            "type": "object",
            "properties": {
              "min_age": {
                "type": "integer",
                "minimum": 0,
                "maximum": 17
              },
              "max_age": {
                "type": "integer",
                "minimum": 0,
                "maximum": 17
              },
              "condition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "\\S"
              }
            },
            "required": ["min_age", "max_age", "condition"],
            "additionalProperties": false
          }
        }
      },
      "required": ["url", "reviewed_on", "ranges"],
      "additionalProperties": false
    }
  }
}
