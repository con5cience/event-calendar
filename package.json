{
  "name": "event-calendar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint web tests scripts *.ts",
    "format": "prettier --write web tests scripts locales internal/artifact/schema *.ts *.json *.js *.yaml README.md",
    "format:check": "prettier --check web tests scripts locales internal/artifact/schema *.ts *.json *.js *.yaml README.md",
    "test:e2e": "playwright test",
    "test:publication": "node tests/publication/run.mjs",
    "test:aeg": "node tests/aeg/run.mjs",
    "test:rhp": "node --import ./tests/setup-capture.mjs --test tests/rhp/capture.test.mjs",
    "test:clique": "node --import ./tests/setup-capture.mjs --test tests/clique/capture.test.mjs",
    "test:plot": "node --import ./tests/setup-capture.mjs --test tests/plot/capture.test.mjs",
    "test:kse": "node --import ./tests/setup-capture.mjs --test tests/kse/capture.test.mjs tests/kse/ball-capture.test.mjs",
    "test:marquis": "node --import ./tests/setup-capture.mjs --test tests/marquis/capture.test.mjs",
    "test:blackbox": "node --import ./tests/setup-capture.mjs --test tests/blackbox/capture.test.mjs",
    "test:venuepilot": "node --import ./tests/setup-capture.mjs --test tests/venuepilot/capture.test.mjs tests/venuepilot/locale.test.mjs",
    "test:meowwolf": "node --import ./tests/setup-capture.mjs --test tests/meowwolf/capture.test.mjs",
    "test:ophelias": "node --import ./tests/setup-capture.mjs --test tests/ophelias/capture.test.mjs",
    "test:buzzard": "node --import ./tests/setup-capture.mjs --test tests/buzzard/capture.test.mjs",
    "test:herbs": "node --import ./tests/setup-capture.mjs --test tests/herbs/capture.test.mjs",
    "test:afton": "node --import ./tests/setup-capture.mjs --test tests/afton/capture.test.mjs",
    "test:contracts": "docker build --target go-test -t event-calendar-contract-tests . && mkdir -p test-results/contracts && docker run --rm --mount type=bind,src=\"$PWD/test-results/contracts\",dst=/handoff -e CONTRACT_HANDOFF_DIR=/handoff event-calendar-contract-tests go test ./internal/artifact -run TestConsumerHandoff -count=1 && CONTRACT_HANDOFF_DIR=test-results/contracts vitest run",
    "test:capture-profiles": "node --import ./tests/setup-capture.mjs --test tests/capture-profile.test.mjs",
    "test:locales": "node tests/locales/run.mjs",
    "test:locale-tools": "node --test tests/package-locale.test.mjs"
  },
  "dependencies": {
    "@fullcalendar/react": "7.1.0",
    "temporal-polyfill": "^1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
